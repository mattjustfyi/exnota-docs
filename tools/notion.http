### Notion setup 1/2: Get code
# 1. Get client ID for the Exnota Notion Integration (see relevant vault)
# 2. Add it to this URL: https://api.notion.com/v1/oauth/authorize?client_id={{notionOauthClientId}}&response_type=code&owner=user&redirect_uri=https%3A%2F%2Fexnota.com%2Fapi%2Fintegration%2Fnotion%2Fmobile-code-redirect
# 3. Open in browser AND START CAPTURING NETWORK REQUESTS
# 4. Go through flow, and get code from attempted redirect
#    (won't actually redirect due to exnota:// scheme).

### Notion setup 2/2: Exchange code for token
POST https://api.notion.com/v1/oauth/token
Content-Type: application/json
Authorization: Basic <base64(client_id:client_secret)>

{
  "grant_type": "authorization_code",
  "code": "03dd92cb-d855-40e8-9a33-c27c428d122e",
  "redirect_uri": "https://exnota.com/api/integration/notion/mobile-code-redirect"
}

### Fetch page (doesn't include children)
curl 'https://api.notion.com/v1/pages/175944fbb2bc8044b844ee7d220df6cd' \
  -H 'Notion-Version: 2022-06-28' \
  -H 'Authorization: Bearer '"{{notionAccessToken}}"''

###
GET https://api.notion.com/v1/pages/175944fbb2bc8044b844ee7d220df6cd
Notion-Version: 2022-06-28
Authorization: Bearer {{notionAccessToken}}

### Fetch database
curl 'https://api.notion.com/v1/databases/175944fbb2bc80549d12f3efb86095ed' \
  -H 'Authorization: Bearer '"{{notionAccessToken}}"'' \
  -H 'Notion-Version: 2022-06-28'

### Query database
curl -X POST 'https://api.notion.com/v1/databases/175944fbb2bc80549d12f3efb86095ed/query' \
  -H 'Authorization: Bearer '"{{notionAccessToken}}"'' \
  -H 'Notion-Version: 2022-06-28' \
  -H "Content-Type: application/json"
  # --data '{
  #   "filter": {
  #     "or": [
  #       {
  #         "property": "In stock",
  #         "checkbox": {
  #           "equals": true
  #         }
  #       },
  #       {
  #         "property": "Cost of next trip",
  #         "number": {
  #           "greater_than_or_equal_to": 2
  #         }
  #       }
  #     ]
  #   },
  #   "sorts": [
  #     {
  #       "property": "Last ordered",
  #       "direction": "ascending"
  #     }
  #   ]
  # }'

### Fetch block children (can be used to get page's content)
curl 'https://api.notion.com/v1/blocks/175944fbb2bc8048a172ec745e4bd05a/children?page_size=100' \
  -H 'Authorization: Bearer '"{{notionAccessToken}}"'' \
  -H "Notion-Version: 2022-06-28"

### Delete block
curl -X DELETE 'https://api.notion.com/v1/blocks/171944fb-b2bc-8098-8bc7-ea1d22de7bdf' \
  -H 'Authorization: Bearer '"{{notionAccessToken}}"'' \
  -H 'Notion-Version: 2022-06-28'

### Get bot
curl -X GET 'https://api.notion.com/v1/users/me' \
  -H 'Authorization: Bearer '"{{notionAccessToken}}"'' \
  -H 'Content-Type: application/json' \
  -H 'Notion-Version: 2022-06-28'

### Update page properties
curl https://api.notion.com/v1/pages/175944fbb2bc8044b844ee7d220df6cd \
  -H 'Authorization: Bearer '"{{notionAccessToken}}"'' \
  -H "Content-Type: application/json" \
  -H "Notion-Version: 2022-06-28" \
  -X PATCH \
	--data '{
  "properties": {
    "Owner": {
        "people": [
          {
            "object": "user",
            "id": "0db71923-77bb-4641-8b7b-b36bf39f2d02"
          }
        ]
    }
  }
}'

### Create database page

curl 'https://api.notion.com/v1/pages' \
  -H 'Authorization: Bearer '"{{notionAccessToken}}"'' \
  -H "Content-Type: application/json" \
  -H "Notion-Version: 2022-06-28" \
  --data '{
	"parent": { "database_id": "175944fbb2bc80549d12f3efb86095ed" },
  "icon": {
  	"emoji": "🥬"
  },
	"cover": {
		"external": {
			"url": "https://upload.wikimedia.org/wikipedia/commons/6/62/Tuscankale.jpg"
		}
	},
	"properties": {
    "Page": {
      "title": [
        {
          "text": {
            "content": "Tuscan Kale"
          }
        }
      ]
    }
	},
	"children": [
		{
			"object": "block",
			"type": "heading_2",
			"heading_2": {
				"rich_text": [{ "type": "text", "text": { "content": "Lacinato kale" } }]
			}
		},
		{
			"object": "block",
			"type": "paragraph",
			"paragraph": {
				"rich_text": [
					{
						"type": "text",
						"text": {
							"content": "Lacinato kale is a variety of kale with a long tradition in Italian cuisine, especially that of Tuscany. It is also known as Tuscan kale, Italian kale, dinosaur kale, kale, flat back kale, palm tree kale, or black Tuscan palm.",
							"link": { "url": "https://en.wikipedia.org/wiki/Lacinato_kale" }
						}
					}
				]
			}
		}
	]
}'

### Append children
curl -X PATCH 'https://api.notion.com/v1/blocks/175944fbb2bc8048a172ec745e4bd05a/children' \
  -H 'Authorization: Bearer '"{{notionAccessToken}}"'' \
  -H "Content-Type: application/json" \
  -H "Notion-Version: 2022-06-28" \
  --data '{
	"children": [
		{
			"object": "block",
			"type": "heading_2",
			"heading_2": {
				"rich_text": [{ "type": "text", "text": { "content": "Lacinato kale" } }]
			}
		},
		{
			"object": "block",
			"type": "paragraph",
			"paragraph": {
				"rich_text": [
					{
						"type": "text",
						"text": {
							"content": "Lacinato kale is a variety of kale with a long tradition in Italian cuisine, especially that of Tuscany. It is also known as Tuscan kale, Italian kale, dinosaur kale, kale, flat back kale, palm tree kale, or black Tuscan palm.",
							"link": { "url": "https://en.wikipedia.org/wiki/Lacinato_kale" }
						}
					}
				]
			}
		},
    {
      "paragraph": {
        "rich_text": [
          {
            "type": "text",
