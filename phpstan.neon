includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:

    paths:
        - app/
        - bootstrap/
        - config/
        - database/
        - resources/
        - routes/
        - storage/
        - tests/
        - tools/

    # Level 10 is the highest level
    level: 10

    ignoreErrors:
        -
            identifier: larastan.noEnvCallsOutsideOfConfig
            path: config

#        - '#PHPDoc tag @var#'
#
#    excludePaths:
#        - ./*/*/FileToBeExcluded.php
